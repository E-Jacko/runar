{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "runar-lang": ["../packages/runar-lang/dist/index.d.ts"],
      "runar-lang/*": ["../packages/runar-lang/dist/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
